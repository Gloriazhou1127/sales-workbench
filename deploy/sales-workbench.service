# Systemd 服务配置
# 放到 /etc/systemd/system/sales-workbench.service
# 然后：systemctl daemon-reload && systemctl enable --now sales-workbench

[Unit]
Description=销售工作台
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/sales-workbench/server
EnvironmentFile=/opt/sales-workbench/.env
ExecStart=/opt/sales-workbench/venv/bin/gunicorn -c gunicorn.conf.py wsgi:application
Restart=always
RestartSec=5

# 日志
StandardOutput=append:/var/log/sales-workbench/app.log
StandardError=append:/var/log/sales-workbench/error.log

[Install]
WantedBy=multi-user.target
